# =========[ OXY - bash ]=========
export USER=$(whoami)

# banner (moldura + logo + letras)
if [[ $- == *i* ]] && command -v oxy-banner >/dev/null 2>&1; then
  clear
  oxy-banner
fi

# nome do prompt: ~/.config/theader/theader.cfg  (TNAME=)  -> comando: cname
_oxy_name() {
  local n=""
  [[ -r "$HOME/.config/theader/theader.cfg" ]] &&
    n=$(sed -n 's/^TNAME=//p' "$HOME/.config/theader/theader.cfg" | tail -n1)
  printf '%s' "${n:-Oxy}"
}
_oxy_ps1() {
  local r='\[\e[1;31m\]' b='\[\e[1;34m\]' c='\[\e[1;36m\]' g='\[\e[90m\]' y='\[\e[1;33m\]' z='\[\e[0m\]'
  PS1="\n${r}┏━━[${c} Termux ${r}]${g}·····${r}[${b} $(_oxy_name) ${r}]━━━${y}>${z}\n${r}┗━━❯${b}❯${g}❯${z} "
}
PROMPT_COMMAND="_oxy_ps1${PROMPT_COMMAND:+; $PROMPT_COMMAND}"

bind -x '"\eh":CMD=${READLINE_LINE%% *}; help "$CMD" 2>/dev/null || man "$CMD" 2>/dev/null || echo "No help found for $CMD"'
[[ -f ~/.bash_aliases ]] && source ~/.bash_aliases
