# =========[ OXY - bash ]=========
export USER=$(whoami)

# banner (moldura + logo + letras com degrade)
if [[ $- == *i* ]] && command -v oxy-banner >/dev/null 2>&1; then
  clear
  COLUMNS=${COLUMNS:-} oxy-banner
fi

# prompt com degrade: montado 1 vez; refeito so quando o nome (TNAME=) muda
_OXY_PN=""
_oxy_ps1() {
  local line name="" label="" cfg="$HOME/.config/theader/theader.cfg"
  if [[ -r "$cfg" ]]; then
    while IFS= read -r line || [[ -n "$line" ]]; do
      [[ "$line" == TNAME=?* ]] && name="${line#TNAME=}"
      [[ "$line" == TLABEL=?* ]] && label="${line#TLABEL=}"
    done <"$cfg"
  fi
  [[ -z "$name" ]] && name="Oxy"
  [[ -z "$label" ]] && label="Termux"
  if [[ "$name|$label" != "$_OXY_PN" ]]; then
    _OXY_PN="$name|$label"
    local out
    out="$(command oxy-banner --prompt bash 2>/dev/null)"
    if [[ -n "$out" ]]; then PS1="$out "; else PS1='\n┏━━[ Termux ]··[ Oxy ] ❯❯❯\n┗━━❯❯❯ '; fi
  fi
}
PROMPT_COMMAND="_oxy_ps1${PROMPT_COMMAND:+; $PROMPT_COMMAND}"

bind -x '"\eh":CMD=${READLINE_LINE%% *}; help "$CMD" 2>/dev/null || man "$CMD" 2>/dev/null || echo "No help found for $CMD"'
[[ -f ~/.bash_aliases ]] && source ~/.bash_aliases
