#!/bin/bash

confi() {
  export FZF_DEFAULT_OPTS=""
  export FZF_DEFAULT_OPTS="--height=40% \
          --color fg:#ffffff,hl:#98c379,fg+:#ffffff,hl+:#98c379,prompt:#61afef,pointer:#e5c07b,marker:#56b6c2 \
          --ansi --reverse --no-info --no-scrollbar \
          --pointer=' '"
}

# ---------- helpers de config (seguros com set -e) ----------
OXY_CFG_FILE="${OXY_CFG_FILE:-$HOME/.config/theader/theader.cfg}"
OXY_BANNER_BIN="${OXY_BANNER_BIN:-$(command -v oxy-banner 2>/dev/null || echo "$HOME/.config/theader/lib/oxybanner")}"

cfg_get() { # cfg_get chave  -> imprime o valor (vazio se nao existir)
  [[ -f "$OXY_CFG_FILE" ]] || return 0
  local line
  line=$(grep -m1 "^$1=" "$OXY_CFG_FILE" 2>/dev/null) || true
  printf '%s' "${line#*=}"
}

cfg_set() { # cfg_set chave valor -> grava sem quebrar com | & \ / espacos
  local key="$1" val="$2" tmp
  mkdir -p "$(dirname "$OXY_CFG_FILE")"
  touch "$OXY_CFG_FILE"
  tmp=$(mktemp)
  grep -v "^$key=" "$OXY_CFG_FILE" >"$tmp" || true
  printf '%s=%s\n' "$key" "$val" >>"$tmp"
  cat "$tmp" >"$OXY_CFG_FILE"
  rm -f "$tmp"
}

# limpa o texto digitado: tira controle/aspas/barras e limita o tamanho
cfg_clean() {
  local v="$1"
  v="${v//[$'\001'-$'\037']/}"
  v="${v//[\"\'\\\`\$|&;<>]/}"
  v="${v#"${v%%[![:space:]]*}"}"
  v="${v%"${v##*[![:space:]]}"}"
  printf '%s' "${v:0:20}"
}

show_banner() { # mostra o banner atual (preview imediato apos mudar algo)
  clear
  OXY_CFG="$OXY_CFG_FILE" OXY_LOGO_DIR="$(dirname "$OXY_CFG_FILE")/logo" "$OXY_BANNER_BIN" || true
}

# paleta do degrade (moldura + letras + prompt)
function c_cor() {
  confi
  local pal result
  result=$(
    printf '%s\n' neon fogo verde oceano roxo | fzf \
      --prompt="Paleta ▶ " --border --margin=1,5% \
      --preview "OXY_PALETA={} OXY_CFG=$OXY_CFG_FILE OXY_LOGO_DIR=$(dirname "$OXY_CFG_FILE")/logo $OXY_BANNER_BIN" \
      --preview-window=down:70%:wrap 2>/dev/null
  ) || true
  pal=$(cfg_clean "$result")
  if [[ -z "$pal" ]]; then
    echo "Nenhuma paleta escolhida. Nada foi alterado."
    return 0
  fi
  cfg_set paleta "$pal"
  echo -e "\\033[32m[✔] Paleta salva: $pal\\033[0m"
  show_banner
}

function type_title() {
  confi
  local current title
  current=$(cfg_get title)
  [[ -z "$current" ]] && current="OXY"

  local preview
  preview=$(mktemp)
  cat >"$preview" <<EOF
#!/usr/bin/env bash
q="\$1"; [ -z "\$q" ] && q="$current"
COLUMNS=\$(tput cols 2>/dev/null || echo 60) bash "$OXY_BANNER_BIN" --text "\$q"
EOF
  chmod +x "$preview"

  # fzf sai com codigo 1 quando a lista esta vazia: "|| true" evita que o
  # set -e do bin/theader mate o script antes de salvar o nome.
  local result
  result=$(
    printf '\n' | fzf \
      --prompt="Titulo ▶ " \
      --query="$current" \
      --print-query \
      --border --margin=1,5% \
      --preview "$preview {q}" \
      --preview-window=down:70%:wrap \
      --phony --no-info 2>/dev/null
  ) || true
  rm -f "$preview"

  title=$(printf '%s\n' "$result" | head -n1)
  title=$(cfg_clean "$title")

  if [[ -z "$title" ]]; then
    echo "Nenhum titulo digitado. Nada foi alterado."
    return 0
  fi

  cfg_set title "$title"
  echo -e "\033[32m[✔] Titulo salvo: \"$title\"\033[0m"
  show_banner
}

# nome que aparece no prompt: ──[ Termux ]·····[ NOME ]───>
function c_name() {
  local current name
  current=$(cfg_get TNAME)
  [[ -z "$current" ]] && current="Oxy"
  read -r -e -i "$current" -p "Nome no prompt: " name || true
  name=$(cfg_clean "$name")
  if [[ -z "$name" ]]; then
    echo "Nenhum nome digitado. Nada foi alterado."
    return 0
  fi
  cfg_set TNAME "$name"
  echo -e "\033[32m[✔] Nome do prompt salvo: \"$name\"\033[0m"
  echo "Pronto: no zsh o novo nome aparece no proximo prompt; no bash/fish, abra uma nova sessao."
  OXY_CFG="$OXY_CFG_FILE" "$OXY_BANNER_BIN" --prompt ansi 2>/dev/null || true
  echo
}

# primeiro rotulo do prompt: ──[ TERMUX ]·····[ Oxy ]───>
function c_term() {
  local current label
  current=$(cfg_get TLABEL)
  [[ -z "$current" ]] && current="Termux"
  read -r -e -i "$current" -p "Rotulo do prompt (1o colchete): " label || true
  label=$(cfg_clean "$label")
  if [[ -z "$label" ]]; then
    echo "Nenhum texto digitado. Nada foi alterado."
    return 0
  fi
  cfg_set TLABEL "$label"
  echo -e "\033[32m[✔] Rotulo do prompt salvo: \"$label\"\033[0m"
  echo "No zsh/bash o novo texto aparece no proximo prompt; no fish, abra uma nova sessao."
  OXY_CFG="$OXY_CFG_FILE" "$OXY_BANNER_BIN" --prompt ansi 2>/dev/null || true
  echo
}

function c_logo() {

  confi
  # =====================================================
  #   FZF Logo + Indent Picker with Preview + Highlights
  #   Works in Bash, Fish, Zsh, Termux
  # =====================================================

  # ====== Config & Logo Directory ======
  CONFIG="$HOME/.config/theader/theader.cfg"
  DIR="$HOME/.config/theader/logo"
  # mkdir -p "$(dirname "$CONFIG")" "$DIR"
  # touch "$CONFIG"

  # ====== Read current config ======
  current_logo=$(grep -m1 '^logo=' "$CONFIG" 2>/dev/null | cut -d'=' -f2) || true
  current_indent=$(grep -m1 '^indent=' "$CONFIG" 2>/dev/null | cut -d'=' -f2) || true
  [[ -z "$current_indent" ]] && current_indent=2

  # ✅ Green star symbol
  green_star=$'\033[32m\033[0m'

  # ====== Step 1: Logo Selection ======
  mapfile -t files < <(find "$DIR" -maxdepth 1 -type f | sort)
  if [ ${#files[@]} -eq 0 ]; then
    echo "No logo files found in $DIR"
    return 0
  fi

  options=()
  idx=1
  for f in "${files[@]}"; do
    name=$(basename "$f")
    if [[ "$name" == "$current_logo" ]]; then
      options+=("$idx. $name $green_star")
    else
      options+=("$idx. $name")
    fi
    ((idx++))
  done

  choice=$(
    printf "%s\n" "${options[@]}" |
      FZF_PREVIEW_DIR="$DIR" OXY_BANNER_BIN="$OXY_BANNER_BIN" OXY_CFG="$OXY_CFG_FILE" fzf \
        --prompt="Select Logo ➤ " \
        --exit-0 \
        --height=40% \
        --border --margin 1,5% \
        --border \
        --reverse \
        --ansi \
        --no-scrollbar \
        --preview 'bash -c "
            FILE=\$(echo {} | sed \"s/^[0-9]\+[.] //; s/ .*//\");
            bash \"$OXY_BANNER_BIN\" --logo \"$FZF_PREVIEW_DIR/\$FILE\" 2>/dev/null
        "' \
        --preview-window=right:50%:wrap
  ) || true

  if [[ -z "$choice" ]]; then
    echo "No logo selected. Exiting."
    return 0
  fi

  choice_clean=$(echo "$choice" | sed 's/^[0-9]\+[.] //' | sed 's/ .*//')

  # ====== Step 2: Indent Selection ======
  indent_opts=(2 3 4 5 6)
  indent_choices=()
  for val in "${indent_opts[@]}"; do
    if [[ "$val" == "$current_indent" ]]; then
      indent_choices+=("$val $green_star")
    else
      indent_choices+=("$val")
    fi
  done

  indent_choice=$(
    printf "%s\n" "${indent_choices[@]}" |
      fzf \
        --prompt="Select Indent ➤ " \
        --exit-0 \
        --height=30% \
        --border \
        --reverse \
        --ansi \
        --no-scrollbar
  ) || true

  if [[ -z "$indent_choice" ]]; then
    indent_choice="$current_indent"
  else
    indent_choice=$(echo "$indent_choice" | awk '{print $1}')
  fi

  # ====== Step 3: Update Config File ======
  cfg_set logo "$choice_clean"
  cfg_set indent "$indent_choice"
  show_banner

  # ====== Done ======
  echo -e "\033[32m[✔] Updated logo=$choice_clean, indent=$indent_choice\033[0m"
}

function key_properties() {

  confi
  CONFIG="$HOME/.config/theader/theader.cfg"
  PROP_DIR="$HOME/.config/theader/tpt"
  TARGET="$HOME/.termux/termux.properties"

  mkdir -p "$(dirname "$CONFIG")"
  mkdir -p "$PROP_DIR"
  touch "$CONFIG"

  # ====== Compute current active hash ======
  if [[ -f "$TARGET" ]]; then
    current_hash=$(sha256sum "$TARGET" | awk '{print $1}')
  else
    current_hash=""
  fi

  # ✅ Green nerd font check mark
  green_star=$'\033[32m\033[0m'

  # ====== Collect available configs ======
  options=()
  i=1
  while IFS= read -r file; do
    filename=$(basename "$file")
    file_hash=$(sha256sum "$file" | awk '{print $1}')
    if [[ "$file_hash" == "$current_hash" ]]; then
      options+=("$i. $filename $green_star")
    else
      options+=("$i. $filename")
    fi
    ((i++))
  done < <(find "$PROP_DIR" -maxdepth 1 -type f | sort)

  # ====== Select with fzf ======
  choice=$(printf "%s\n" "${options[@]}" |
    fzf --prompt="Select termux.properties ➤ " --exit-0 \
      --margin 1,5% --height=40% --border \
      --ansi --no-info --reverse --no-scrollbar) || true

  [[ -z "$choice" ]] && echo "No selection made. Exiting." && return 0

  # Strip number + star → just filename
  choice_clean="${choice#*. }"
  choice_clean="${choice_clean%% *}"

  # ====== Update termux.properties ======
  selected_file="$PROP_DIR/$choice_clean"
  selected_hash=$(sha256sum "$selected_file" | awk '{print $1}')

  cp "$selected_file" "$TARGET"

  if grep -q '^termux_properties=' "$CONFIG"; then
    sed -i "s|^termux_properties=.*|termux_properties=$selected_hash|" "$CONFIG"
  else
    echo "termux_properties=$selected_hash" >>"$CONFIG"
  fi

  sync
  termux-reload-settings 2>/dev/null || true
  echo -e "\033[32m[✔] Updated termux.properties → $choice_clean\033[0m"

  # Algumas opcoes do Termux (teclado extra, altura da barra...) so passam a valer
  # depois de reiniciar o app. Oferece fazer isso agora, sem precisar "sair e entrar".
  local ans=""
  read -r -n1 -p "Reiniciar o Termux agora para aplicar o teclado? [s/N] " ans || true
  echo
  if [[ "$ans" == [sSyY] ]]; then
    echo "Fechando o Termux... abra o app de novo."
    sleep 1
    am startservice -a com.termux.service_stop -n com.termux/.app.TermuxService >/dev/null 2>&1 ||
      echo "Nao consegui fechar sozinho: deslize a barra de notificacoes e toque em EXIT no Termux."
  else
    echo "Se o teclado nao mudou, feche e abra o Termux (ou rode 'theader' e escolha Change Keyboard de novo)."
  fi
}

# ====== Change current theme from .zshrc ====== #
function c_theme() {
  confi
  ZSHRC="$HOME/.zshrc"
  ZSH="$HOME/.oh-my-zsh"
  ZSH_CUSTOM="${ZSH_CUSTOM:-$ZSH/custom}"

  # ====== Get current theme from .zshrc ======
  current_theme=$(grep '^ZSH_THEME=' "$ZSHRC" | cut -d'"' -f2)

  # ✅ Green nerd font star
  green_star=$'\033[32m\033[0m'

  # ====== Collect themes ======
  mapfile -t themes < <(
    find "$ZSH/themes" "$ZSH_CUSTOM/themes" -maxdepth 1 -type f -name "*.zsh-theme" 2>/dev/null |
      sort | while read -r file; do basename "$file" .zsh-theme; done
  )

  options=()
  i=1
  for theme in "${themes[@]}"; do
    if [[ "$theme" == "$current_theme" ]]; then
      options+=("$i. $theme $green_star")
    else
      options+=("$i. $theme")
    fi
    ((i++))
  done

  # ====== Theme Selection ======
  choice=$(printf "%s\n" "${options[@]}" |
    fzf --prompt="Select ZSH Theme ➤ " --exit-0 \
      --margin 1,5% --height=40% --border \
      --ansi --no-info --reverse --no-scrollbar) || true

  [[ -z "$choice" ]] && echo "No selection made. Exiting." && return 0

  # Strip numbering and star
  choice_clean="${choice#*. }"
  choice_clean="${choice_clean%% *}"

  # ====== Update .zshrc ======
  if grep -q '^ZSH_THEME=' "$ZSHRC"; then
    sed -i "s|^ZSH_THEME=.*|ZSH_THEME=\"$choice_clean\"|" "$ZSHRC"
  else
    echo "ZSH_THEME=\"$choice_clean\"" >>"$ZSHRC"
  fi

  echo -e "\033[32m[✔] Updated theme to: $choice_clean\033[0m"
  echo "Run 'source ~/.zshrc' to apply changes."
}
