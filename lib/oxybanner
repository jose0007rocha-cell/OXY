#!/usr/bin/env bash
# =====================================================================
#  OXY banner - moldura fina em degrade + logo + letras de bloco em degrade
#  100% sem fork (so builtins do bash) e escrito de uma vez so na tela.
#
#  Uso:
#    oxy-banner                    banner completo (le ~/.config/theader/theader.cfg)
#    oxy-banner --text "Nome"      so as letras grandes (preview do ctitle / ccor)
#    oxy-banner --prompt zsh|bash|ansi   imprime a string do prompt com degrade
#  Variaveis: OXY_CFG, OXY_LOGO_DIR, OXY_PALETA (forca uma paleta)
# =====================================================================
export LC_ALL=C.UTF-8
shopt -s extglob

CFG="${OXY_CFG:-$HOME/.config/theader/theader.cfg}"
LOGO_DIR="${OXY_LOGO_DIR:-$HOME/.config/theader/logo}"

# ---------- config (sem fork) ----------
title="OXY"; logo="dragao.txt"; indent=2; paleta="neon"; frame="mid"; tname="Oxy"
if [[ -f "$CFG" ]]; then
  while IFS='=' read -r k v || [[ -n "$k" ]]; do
    v="${v%$'\r'}"
    case "$k" in
      title)  [[ -n "$v" ]] && title="$v" ;;
      logo)   [[ -n "$v" ]] && logo="$v" ;;
      indent) [[ "$v" =~ ^[0-9]+$ ]] && indent="$v" ;;
      paleta) [[ -n "$v" ]] && paleta="$v" ;;
      frame)  [[ -n "$v" ]] && frame="$v" ;;
      TNAME)  [[ -n "$v" ]] && tname="$v" ;;
    esac
  done <"$CFG"
fi
paleta="${OXY_PALETA:-$paleta}"


# tira os codigos de cor ESC[...m de $1 -> REPLY (so builtins, sem regex: o
# padrao extglob ${x//\e\[*([0-9;])m/} leva ~0,5s por linha em UTF-8)
strip_ansi() {
  local s="$1" out=""
  while [[ "$s" == *$'\e['* ]]; do
    out+="${s%%$'\e['*}"
    s="${s#*$'\e['}"
    s="${s#*m}"
  done
  REPLY="$out$s"
}

# ---------- paletas (r g b por parada) ----------
PAL_R=(); PAL_G=(); PAL_B=()
set_palette() {
  local -a stops
  case "$1" in
    fogo)   stops=("255 230 0" "255 140 0" "255 50 50" "200 0 90") ;;
    verde)  stops=("0 255 170" "50 255 70" "160 230 20") ;;
    oceano) stops=("0 255 200" "0 170 255" "60 90 255") ;;
    roxo)   stops=("255 120 200" "190 80 255" "80 120 255") ;;
    *)      stops=("0 230 255" "70 130 255" "180 80 255" "255 70 170") ;; # neon
  esac
  local s
  for s in "${stops[@]}"; do
    set -- $s
    PAL_R+=("$1"); PAL_G+=("$2"); PAL_B+=("$3")
  done
}
set_palette "$paleta"

# cor no ponto i de t (0..t-1) -> GR GG GB
gradcol() {
  local i=$1 t=$2 n=${#PAL_R[@]} pos seg f
  ((t < 2)) && t=2
  ((i < 0)) && i=0
  ((i > t - 1)) && i=$((t - 1))
  pos=$((i * (n - 1) * 256 / (t - 1)))
  seg=$((pos / 256)); f=$((pos % 256))
  if ((seg >= n - 1)); then seg=$((n - 2)); f=256; fi
  GR=$((PAL_R[seg] + (PAL_R[seg + 1] - PAL_R[seg]) * f / 256))
  GG=$((PAL_G[seg] + (PAL_G[seg + 1] - PAL_G[seg]) * f / 256))
  GB=$((PAL_B[seg] + (PAL_B[seg + 1] - PAL_B[seg]) * f / 256))
}
# monta o escape de cor em CS ($1=1 -> video reverso, para bordas finas)
colorseq() {
  if (($1)); then printf -v CS '\e[0;7;38;2;%d;%d;%dm' "$GR" "$GG" "$GB"
  else printf -v CS '\e[0;38;2;%d;%d;%dm' "$GR" "$GG" "$GB"; fi
}

# ======================= MODO PROMPT =======================
if [[ "$1" == "--prompt" ]]; then
  sh="${2:-ansi}"
  n="$tname"
  case "$sh" in
    zsh)  n="${n//\\/\\\\}"; n="${n//%/%%}"; n="${n//\$/\\\$}"; n="${n//\`/\\\`}"; ob='%{'; cb='%}' ;;
    bash) n="${n//\\/\\\\}"; n="${n//\$/\\\$}"; n="${n//\`/\\\`}"; ob='\['; cb='\]' ;;
    *)    ob=''; cb='' ;;
  esac
  # segmentos: texto|negrito
  segs=("┏━━[|0" " Termux |1" "]|0" "·····|0" "[|0" " ${n} |1" "]|0" "━━━>|0")
  total=0
  for sg in "${segs[@]}"; do t="${sg%|*}"; t="${t//\\\\/x}"; ((total += ${#t})); done
  out=$'\n'; idx=0
  for sg in "${segs[@]}"; do
    txt="${sg%|*}"; bold="${sg##*|}"
    # para contar a largura visivel ignora as barras de escape do zsh/bash
    vis="${txt//\\\\/x}"; vis="${vis//%%/x}"; vis="${vis//\\\$/x}"; vis="${vis//\\\`/x}"
    w=${#vis}
    gradcol "$((idx + w / 2))" "$total"
    if [[ "$bold" == 1 ]]; then printf -v CS '%s\e[1;38;2;%d;%d;%dm%s' "$ob" "$GR" "$GG" "$GB" "$cb"
    else printf -v CS '%s\e[0;38;2;%d;%d;%dm%s' "$ob" "$GR" "$GG" "$GB" "$cb"; fi
    out+="${CS}${txt}"
    ((idx += w))
  done
  out+=$'\n'
  l2=("┗" "━" "━" "❯" "❯" "❯"); i=0
  for ch in "${l2[@]}"; do
    gradcol "$i" 6
    printf -v CS '%s\e[1;38;2;%d;%d;%dm%s' "$ob" "$GR" "$GG" "$GB" "$cb"
    out+="${CS}${ch}"; ((i++))
  done
  out+="${ob}"$'\e[0m'"${cb} "
  printf '%s' "$out"
  exit 0
fi

MODE=full
if [[ "$1" == "--text" ]]; then MODE=text; title="${2:-$title}"; fi

# ---------- largura do terminal ----------
W="${COLUMNS:-0}"
if ((W < 1)); then W=$(tput cols 2>/dev/null || echo 0); fi
if ((W < 1)); then read -r _ W < <(stty size 2>/dev/null); fi
((W < 1)) && W=60
((W < 24)) && W=24

# ---------- fonte de blocos (3x5; M/N/W maiores) ----------
declare -A G=(
  [A]="010 101 111 101 101"  [B]="110 101 110 101 110"  [C]="011 100 100 100 011"
  [D]="110 101 101 101 110"  [E]="111 100 110 100 111"  [F]="111 100 110 100 100"
  [G]="011 100 101 101 011"  [H]="101 101 111 101 101"  [I]="111 010 010 010 111"
  [J]="001 001 001 101 010"  [K]="101 101 110 101 101"  [L]="100 100 100 100 111"
  [M]="10001 11011 10101 10001 10001"
  [N]="1001 1101 1011 1001 1001"
  [O]="111 101 101 101 111"  [P]="110 101 110 100 100"  [Q]="111 101 101 111 001"
  [R]="110 101 110 101 101"  [S]="011 100 010 001 110"  [T]="111 010 010 010 010"
  [U]="101 101 101 101 111"  [V]="101 101 101 101 010"
  [W]="10001 10001 10101 11011 10001"
  [X]="101 101 010 101 101"  [Y]="101 101 010 010 010"  [Z]="111 001 010 100 111"
  [0]="111 101 101 101 111"  [1]="010 110 010 010 111"  [2]="110 001 010 100 111"
  [3]="110 001 010 001 110"  [4]="101 101 111 001 001"  [5]="111 100 110 001 110"
  [6]="011 100 111 101 111"  [7]="111 001 010 010 010"  [8]="111 101 111 101 111"
  [9]="111 101 111 001 110"
  ["-"]="000 000 111 000 000" ["."]="0 0 0 0 1" ["_"]="000 000 000 000 111"
  ["!"]="1 1 1 0 1"           [" "]="00 00 00 00 00"
)

# ---------- normaliza o texto (maiusculas, tira acentos) ----------
t="${title^^}"
for p in "Á:A" "À:A" "Ã:A" "Â:A" "Ä:A" "É:E" "È:E" "Ê:E" "Ë:E" "Í:I" "Ì:I" "Î:I" \
         "Ó:O" "Ò:O" "Õ:O" "Ô:O" "Ö:O" "Ú:U" "Ù:U" "Û:U" "Ü:U" "Ç:C" "Ñ:N"; do
  t="${t//${p%%:*}/${p##*:}}"
done
chars=()
for ((i = 0; i < ${#t}; i++)); do
  c="${t:i:1}"
  [[ -n "${G[$c]+x}" ]] && chars+=("$c")
done
((${#chars[@]} == 0)) && chars=(O X Y)

# largura (em pixels de fonte) dos glifos, sem fork
declare -A GW
for c in "${chars[@]}"; do
  if [[ -z "${GW[$c]+x}" ]]; then r=(${G[$c]}); GW[$c]=${#r[0]}; fi
done
calc_total() { total_px=0; local c; for c in "${chars[@]}"; do ((total_px += GW[$c] + 1)); done; ((total_px--)); }
calc_total

# ---------- logo ----------
logo_rows=(); logo_pw=(); logo_w=0
if [[ "$MODE" == full && W -ge 44 && -f "$LOGO_DIR/$logo" ]]; then
  while IFS= read -r line || [[ -n "$line" ]]; do
    logo_rows+=("$line")
    strip_ansi "$line"
    logo_pw+=("${#REPLY}")
    ((${#REPLY} > logo_w)) && logo_w=${#REPLY}
  done <"$LOGO_DIR/$logo"
fi
((${#logo_rows[@]} > 8)) && logo_rows=("${logo_rows[@]:0:8}")

if [[ "$MODE" == text ]]; then
  avail=$W; left=0
else
  left=$((${#logo_rows[@]} ? indent + logo_w + 2 : 0))
  avail=$((W - 2 - left - 1))
fi

px=2; ((total_px * 2 > avail)) && px=1
while ((total_px > avail && ${#chars[@]} > 1)); do
  unset 'chars[${#chars[@]}-1]'; chars=("${chars[@]}")
  calc_total
done
text_w=$((total_px * px))

# ---------- cor de cada coluna do titulo (degrade horizontal) ----------
COLFG=()
for ((c = 0; c < text_w; c++)); do
  gradcol "$c" "$text_w"
  printf -v 'COLFG[c]' '\e[38;2;%d;%d;%dm' "$GR" "$GG" "$GB"
done

title_rows=()
for ((row = 0; row < 5; row++)); do
  s=""; col=0
  for ci in "${!chars[@]}"; do
    pat=(${G[${chars[ci]}]})
    bits="${pat[row]}"
    for ((b = 0; b < ${#bits}; b++)); do
      if [[ "${bits:b:1}" == 1 ]]; then
        if ((px == 2)); then s+="${COLFG[col * 2]}██"; else s+="${COLFG[col]}█"; fi
      else
        ((px == 2)) && s+="  " || s+=" "
      fi
      ((col++))
    done
    if ((ci < ${#chars[@]} - 1)); then
      ((px == 2)) && s+="  " || s+=" "
      ((col++))
    fi
  done
  title_rows+=("$s"$'\e[0m')
done

if [[ "$MODE" == text ]]; then
  out=""
  for r in "${title_rows[@]}"; do out+="$r"$'\n'; done
  printf '%s' "$out"
  exit 0
fi

# ---------- moldura em degrade (espessura: fine=3/8, thick=1/2, thin=1/8) ----------
case "$frame" in
  thick) TOPC="▀" TOPV=0 BOTC="▄" LC="▌" RC="▐" RV=0 ;;
  thin)  TOPC="▇" TOPV=1 BOTC="▁" LC="▏" RC="▉" RV=1 ;;
  *)     TOPC="▅" TOPV=1 BOTC="▃" LC="▍" RC="▋" RV=1 ;;
esac
RST=$'\e[0m'
inner=$((W - 2))

top=""; bot=""
for ((i = 0; i < W; i++)); do
  gradcol "$i" "$W";            colorseq "$TOPV"; top+="${CS}${TOPC}"
  gradcol "$((W - 1 - i))" "$W"; colorseq 0;      bot+="${CS}${BOTC}"
done
top+="$RST"; bot+="$RST"

LSEQ=(); RSEQ=()
for ((r = 0; r < 8; r++)); do
  gradcol "$r" 8;       colorseq 0;     LSEQ[r]="${CS}${LC}"
  gradcol "$((7 - r))" 8; colorseq "$RV"; RSEQ[r]="${CS}${RC}"
done

pad() { printf -v PADS '%*s' "$(($1 < 0 ? 0 : $1))" ""; }

region=$((inner - left))
tl=$(((region - text_w) / 2)); ((tl < 0)) && tl=0
tr=$((region - text_w - tl)); ((tr < 0)) && tr=0

out="$top"$'\n'
for ((r = 0; r < 8; r++)); do
  line="${LSEQ[r]}${RST}"
  if ((${#logo_rows[@]})); then
    lr="${logo_rows[r]:-}"
    pad "$indent"; line+="$PADS${lr}${RST}"
    pad "$((logo_w - ${logo_pw[r]:-0} + 2))"; line+="$PADS"
  fi
  ti=$((r - 1))
  if ((ti >= 0 && ti < 5)); then
    pad "$tl"; line+="$PADS${title_rows[ti]}"
    pad "$tr"; line+="$PADS"
  else
    pad "$region"; line+="$PADS"
  fi
  line+="${RSEQ[r]}${RST}"
  out+="$line"$'\n'
done
out+="$bot"$'\n'
printf '%s' "$out"
